NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public
RABBITMQ_URL=amqp://app:app@localhost:5672
RABBITMQ_PUBLISH_TIMEOUT_MS=2000

# Auth: demo client-credentials issuer (disabled when ENABLE_DEMO_AUTH=false)
JWT_SECRET=change-me-to-a-long-random-string-0123456789abcdef
JWT_TTL_SECONDS=900
ENABLE_DEMO_AUTH=true
DEMO_CLIENT_ID=demo-client
DEMO_CLIENT_SECRET=demo-client-secret

# Field-level encryption (base64, 32 bytes each). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=dAUrMisLDpwyd2b7GgZXJTKUNKUvPnad72r5Mu3wzEQ=
BLIND_INDEX_KEY=swcoEtnDg6eMxp44VqTc1zowTyhyXydwnOXfcOisbJs=

# External gateways (point to the in-process mocks by default)
GATEWAY_BASE_URL=http://localhost:3001/mock
GATEWAY_TIMEOUT_MS=5000
WATHIQ_TIMEOUT_MS=3000

# Retry policy (RabbitMQ delay queues, exponential backoff)
RETRY_ATTEMPTS=5
RETRY_BACKOFF_MS=2000

# Outbox relay: re-publishes events that could not be published at write time
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_RELAY_AFTER_MS=5000

# Mock behaviour
MOCK_SLOW_RESPONSE_MS=6000
MOCK_CHAOS_RATE=0
